{
  "name": "aurapro",
  "version": "3.9.30",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=12 <13"
  },
  "description": "Cross-platform desktop client for AuraPro local AI inference, translation, voice, and knowledge workflows.",
  "main": "./out/main/index.js",
  "author": "AuraPro Inc.",
  "homepage": "https://aurapro.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuraPro-Official/AuraPro-Desktop.git"
  },
  "bugs": {
    "url": "https://github.com/AuraPro-Official/AuraPro-Desktop/issues"
  },
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "lint:ci": "eslint --max-warnings 0 .",
    "test:llamacpp-releases": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-llamacpp-release-resolution.mjs",
    "test:platform-support": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/test-platform-support.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.2.1",
    "tippy.js": "^6.3.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
